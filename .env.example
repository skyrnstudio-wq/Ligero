NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_PROJECT_ID="your_project_id"
SANITY_API_WRITE_TOKEN="your_write_token"
SANITY_REVALIDATE_SECRET="your_revalidate_secret"

# Razorpay Payment Gateway
# Dashboard: https://dashboard.razorpay.com/app/keys
# Test Key format: rzp_test_xxxxxxxxxxxxxx
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret"

# Transactional Order Emails (Resend)
# Dashboard: https://resend.com/api-keys
RESEND_API_KEY="re_your_resend_api_key"
RESEND_FROM_EMAIL="Ligero Parfum <sales@ligeroparfum.com>"
# Optional: defaults to sales@ligeroparfum.com (set to "off" to disable atelier copy)
ORDER_NOTIFICATION_EMAIL="sales@ligeroparfum.com"
# Optional: separate secret for /api/orders/dispatch-webhook (defaults to SANITY_REVALIDATE_SECRET)
SANITY_ORDER_WEBHOOK_SECRET="your_order_webhook_secret"
